DATABASE_URL=postgresql://postgres:password@localhost:5434/gallery
CELERY_BROKER=redis://localhost:6380

# CLIP: ViT-B-16-SigLIP2 (мультиязычная, вектор 768, ~1.5 ГБ). Скачивается сама в кэш HuggingFace.
# Префикс hf-hub: обязателен. Если меняете модель, поменяйте размерность VECTOR(...) в migrations/001_init.sql.
CLIP_MODEL_NAME=hf-hub:timm/ViT-B-16-SigLIP2

# PaddleOCR: лёгкие mobile-модели PP-OCRv5; eslav читает русский, украинский, белорусский и английский.
PADDLEOCR_DET_MODEL=PP-OCRv5_mobile_det
PADDLEOCR_REC_MODEL=eslav_PP-OCRv5_mobile_rec
# Используется, только если обе модели выше пустые:
PADDLEOCR_LANG=ru
PADDLEOCR_DEVICE=cpu
# PADDLEOCR_ENABLE_MKLDNN=false

# Откуда браузер может обращаться к API (через запятую). Dev-режим Vite идёт через прокси, ему это не нужно.
# CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Куда сохранять загруженные картинки и миниатюры (по умолчанию backend/storage).
# STORAGE_DIR=
