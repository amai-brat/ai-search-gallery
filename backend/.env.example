# Все переменные необязательны, ниже значения по умолчанию.

# Данные приложения: база SQLite (gallery.db), загруженные файлы и миниатюры (storage).
# По умолчанию %LOCALAPPDATA%\AISearchGallery (Linux: ~/.local/share/ai-search-gallery).
# DATA_DIR=
# DATABASE_PATH=
# STORAGE_DIR=

# Адрес приложения (сайт и API).
# HOST=127.0.0.1
# PORT=8000
# Запускать индексатор вместе с приложением (false — только поиск).
# INDEXER_ENABLED=true

# Модели (ONNX) скачиваются сами при первом запуске в backend/models (меняется MODELS_DIR).
# MODELS_DIR=

# CLIP: ViT-B-16-SigLIP2 (мультиязычная, вектор 768, ~1.5 ГБ), ONNX-экспорт immich-app/<имя>__webli.
# Быстрее, чуть хуже по качеству: ViT-B-32-SigLIP2-256 (тоже вектор 768). После смены модели нужна переиндексация.
CLIP_MODEL_NAME=ViT-B-16-SigLIP2
# CLIP_THREADS=0

# OCR: RapidOCR с моделями PP-OCRv5 mobile det + eslav mobile rec (русский, украинский, белорусский, английский).
# Картинки больше OCR_MAX_SIDE по длинной стороне уменьшаются перед распознаванием (0 — не уменьшать).
# OCR_MAX_SIDE=960
# OCR_THREADS=0

# Откуда браузер может обращаться к API с другого адреса (через запятую). Встроенному сайту и
# dev-режиму Vite (прокси) это не нужно.
# CORS_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
